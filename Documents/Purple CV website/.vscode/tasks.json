{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Vite dev server",
            "type": "shell",
            "command": "npm run dev -- --port 8080",
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE v",
                    "endsPattern": "Local:"
                }
            }
        }
    ]
}
